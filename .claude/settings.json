{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/scripts/sync-agents.ps1\"",
            "timeout": 30,
            "statusMessage": "Syncing agents to your personal Claude folder"
          }
        ]
      }
    ]
  }
}
