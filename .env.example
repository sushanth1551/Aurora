# Copy to .env in the repository root for local development:
#   Copy-Item .env.example .env
# Never commit .env or real credentials. Every external credential is optional;
# the API starts without them. Values below are placeholders only.
APP_NAME=AURORA
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# PostgreSQL (not connected at startup)
DATABASE_URL=postgresql+psycopg://aurora:change-me@localhost:5432/aurora

# Neo4j (not connected at startup)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Research and SEO providers
FIRECRAWL_API_KEY=
SERPAPI_API_KEY=

# LLM providers
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# WordPress (publishing requires explicit human approval)
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=

# Google Search Console OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Docker Compose only
POSTGRES_PASSWORD=
