# Copy to .env in the repository root for local development:
#   Copy-Item .env.example .env
# Never commit .env or real credentials. Provider keys are optional for startup
# and tests; research requests need SERPAPI_API_KEY and FIRECRAWL_API_KEY.
# Values below are placeholders only.
APP_NAME=AURORA
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Local API protection. Every route except /api/v1/health and /api/v1/health/ready needs
# "Authorization: Bearer <AURORA_API_TOKEN>". Generate it (and a strong NEO4J_PASSWORD) with
#   scripts\init-local-secrets.ps1
# Leave empty here; without it the protected routes answer 503 (the app still starts).
AURORA_API_TOKEN=
API_WRITE_RATE_LIMIT_PER_MINUTE=60
API_PUBLIC_RATE_LIMIT_PER_MINUTE=60
# Wrong tokens: after API_AUTH_MAX_FAILURES within API_AUTH_LOCKOUT_SECONDS the client is locked out.
API_AUTH_MAX_FAILURES=10
API_AUTH_LOCKOUT_SECONDS=300

# PostgreSQL (async driver). Matches the docker-compose.yml development default.
DATABASE_URL=postgresql+asyncpg://aurora:aurora_dev_password@localhost:5432/aurora
# Docker Compose only; leave empty to use the compose development default.
POSTGRES_PASSWORD=

# Research providers
SERPAPI_API_KEY=
FIRECRAWL_API_KEY=

# Research engine limits
RESEARCH_MAX_RESULTS=10
RESEARCH_MAX_PAGES=10
RESEARCH_TIMEOUT_SECONDS=60
RESEARCH_MAX_RETRIES=3
RESEARCH_MAX_CONCURRENT_EXTRACTIONS=3
# Optional: HEAD-trace redirects (manually, revalidating every hop) before extraction.
RESEARCH_PREFLIGHT_REDIRECTS=false

# Website intelligence (Module 3) limits. All are caps, not targets.
WEBSITE_RESEARCH_MAX_WEBSITES=10
WEBSITE_RESEARCH_MAX_PAGES_PER_SITE=20
WEBSITE_RESEARCH_MAX_TOTAL_PAGES=100
WEBSITE_RESEARCH_MAX_CRAWL_DEPTH=2
WEBSITE_RESEARCH_MAX_CONCURRENT_SITES=2
WEBSITE_RESEARCH_MAX_CONCURRENT_PAGES=2
WEBSITE_RESEARCH_TIMEOUT_SECONDS=300
WEBSITE_RESEARCH_MAP_TIMEOUT_SECONDS=120
WEBSITE_RESEARCH_BATCH_TIMEOUT_SECONDS=120
WEBSITE_RESEARCH_MAX_CONCURRENT_SEARCHES=2
# Retries for map / batch start: only rate limits (429) are retried; timeouts never are.
WEBSITE_RESEARCH_MAX_RETRIES=1
# In-memory cache of identical searches and maps (0 disables)
WEBSITE_RESEARCH_CACHE_TTL_SECONDS=600
WEBSITE_RESEARCH_CACHE_MAX_ENTRIES=128
# Local caps (not provider plan limits)
FIRECRAWL_SCRAPE_TIMEOUT_SECONDS=30
FIRECRAWL_MAX_CONCURRENT_REQUESTS=2
RESEARCH_RETRY_BASE_DELAY_SECONDS=0.5
RESEARCH_RETRY_MAX_DELAY_SECONDS=8
WEBSITE_RESEARCH_MAX_CONTENT_SIZE_MB=5
WEBSITE_RESEARCH_MAX_MAP_URLS=100
# LLM extraction is optional and off by default; no LLM adapter is implemented yet,
# so enabling it only adds a note to the response and deterministic extraction is used.
WEBSITE_RESEARCH_ENABLE_LLM_EXTRACTION=false
WEBSITE_RESEARCH_ENABLE_REPORTS=true
# Best-effort robots.txt pre-filter (AURORA's own user agent) before scraping.
WEBSITE_RESEARCH_RESPECT_ROBOTS=true

# Tests. Live tests call real providers and spend credits; keep false by default.
AURORA_RUN_LIVE_INTEGRATION_TESTS=false
# Disposable PostgreSQL database for integration tests (never your dev database):
# AURORA_TEST_DATABASE_URL=postgresql+asyncpg://aurora:aurora_dev_password@localhost:5432/aurora_test

# Neo4j knowledge graph (Module 5). Optional: the app starts without it and graph
# endpoints return 503 graph_not_configured until NEO4J_PASSWORD is set.
# Local: docker compose --profile graph up -d neo4j (browser http://localhost:7474)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_CONNECTION_TIMEOUT_SECONDS=10
NEO4J_QUERY_TIMEOUT_SECONDS=30
NEO4J_MAX_CONNECTION_POOL_SIZE=50
# Compose host ports (change if 7474/7687 are taken)
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

GRAPH_SYNC_ENABLED=true
GRAPH_SYNC_BATCH_SIZE=100
GRAPH_SYNC_MAX_RETRIES=3
GRAPH_MAX_TRAVERSAL_DEPTH=3
GRAPH_MAX_QUERY_RESULTS=100
GRAPH_ENABLE_LLM_ENTITY_RESOLUTION=false
GRAPH_LLM_RESOLUTION_MIN_CONFIDENCE=0.9
# Live Neo4j tests write and then delete their own nodes; keep false by default.
GRAPH_RUN_LIVE_TESTS=false

# LLM providers (Module 4). The mock provider needs no key and is the default.
# LLM_PROVIDER=groq|openai|anthropic|mock. Only the selected provider needs a key.
LLM_PROVIDER=mock
# Groq (OpenAI-compatible Chat Completions). Recommended low-cost primary provider.
# Free-tier and Developer-tier limits differ; see docs/llm-cost-management.md.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# json_schema (gpt-oss models) or json_object (JSON mode)
GROQ_STRUCTURED_OUTPUT=json_schema
GROQ_EXCLUDE_REASONING=true
# low | medium | high (gpt-oss only); empty = provider default
GROQ_REASONING_EFFORT=
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_MAX_OUTPUT_TOKENS=4096
LLM_ENABLE_PROVIDER_FALLBACK=false
LLM_FALLBACK_PROVIDER=anthropic
# Prices per million tokens, copied from the providers' official pricing pages
# (they change; nothing is built in, so cost is "unavailable" until set), e.g.
# LLM_PRICING_JSON={"openai:<model>": {"input_per_million": 0, "output_per_million": 0, "cached_input_per_million": 0}}
# Groq example (openai/gpt-oss-20b, USD per 1M tokens, from console.groq.com/docs/model/openai/gpt-oss-20b):
# LLM_PRICING_JSON={"groq:openai/gpt-oss-20b": {"input_per_million": 0.075, "output_per_million": 0.30, "cached_input_per_million": 0.037, "currency": "USD"}}
LLM_PRICING_JSON=

# Intelligence engine limits (requests can only lower them)
INTELLIGENCE_MAX_ITERATIONS=3
INTELLIGENCE_MAX_FOLLOWUP_QUERIES=5
INTELLIGENCE_MAX_TOTAL_QUERIES=10
INTELLIGENCE_MAX_DURATION_SECONDS=300
INTELLIGENCE_MAX_LLM_CALLS=15
INTELLIGENCE_MAX_TOKEN_BUDGET=50000
# Leave empty for no cost cap; a cap requires a price for the model in LLM_PRICING_JSON.
INTELLIGENCE_MAX_ESTIMATED_COST=
# Evidence-token budget of the research context (global default). Per-provider
# overrides below win when set; blank = use the global value. These are application
# budgets for the <evidence> block, not provider context windows or rate limits.
INTELLIGENCE_CONTEXT_MAX_TOKENS=12000
# Groq entry-tier per-minute token allowances are small, so start low and raise
# it once your account's limits page shows more headroom.
INTELLIGENCE_CONTEXT_MAX_TOKENS_GROQ=4000
INTELLIGENCE_CONTEXT_MAX_TOKENS_OPENAI=
INTELLIGENCE_CONTEXT_MAX_TOKENS_ANTHROPIC=
INTELLIGENCE_CONTEXT_MAX_TOKENS_MOCK=
INTELLIGENCE_MAX_SOURCES=40
# Follow-up research spends SerpApi/Firecrawl credits; it also needs the request opt-in.
INTELLIGENCE_ENABLE_FOLLOWUP_RESEARCH=true
INTELLIGENCE_ENABLE_LLM_EVALUATION=false
INTELLIGENCE_MIN_CITATION_COVERAGE=0.8
INTELLIGENCE_MAX_UNSUPPORTED_CLAIMS=0
INTELLIGENCE_FRESHNESS_DAYS=365
# Live LLM tests spend real credits; keep false by default.
AURORA_RUN_LIVE_LLM_TESTS=false

# WordPress (future; publishing requires explicit human approval)
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=

# Google Search Console OAuth (future)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Provider protection (local limits, not provider plan limits)
SERPAPI_MAX_CONCURRENT_REQUESTS=2
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
PROVIDER_CIRCUIT_COOLDOWN_SECONDS=30
# Hard cap on provider HTTP requests per intelligence run, retries included (0 = unlimited)
WEBSITE_RESEARCH_MAX_PROVIDER_REQUESTS=0

# Technical SEO audit (Phase 2). Caps per audit; the plan shows the resulting
# estimate and nothing is fetched until it is approved. Uses FIRECRAWL_API_KEY
# (one raw-HTML scrape per audited HTML page); no SerpApi or LLM calls.
SEO_AUDIT_MAX_PAGES=25
SEO_AUDIT_MAX_LINK_CHECKS=50
SEO_AUDIT_MAX_SITEMAPS=5
SEO_AUDIT_MAX_SITEMAP_URLS=10000
SEO_AUDIT_MAX_SITEMAP_BYTES=10000000
SEO_AUDIT_MAX_HTML_CHARS=3000000
SEO_AUDIT_CONCURRENCY=2
SEO_AUDIT_MAX_DURATION_SECONDS=600
SEO_AUDIT_HTTP_TIMEOUT_SECONDS=10

# Keyword research (Phase 3). SerpApi searches are the only metered resource; the plan shows an
# upper bound and nothing is searched until it is approved. Fresh stored SERPs are reused.
SEO_KEYWORD_MAX_SEEDS=10
SEO_KEYWORD_MAX_QUERIES=10
SEO_KEYWORD_MAX_CANDIDATES=100
SEO_KEYWORD_MAX_DURATION_SECONDS=600
# Hours a stored SERP may be reused instead of searching again (0 disables the cache).
SEO_SERP_CACHE_TTL_HOURS=24
# Pause between searches (seconds).
SEO_SERP_MIN_INTERVAL_SECONDS=1.0
# Your SerpApi price per search, if you want cost estimates. Empty = costs are not estimated.
SEO_SERPAPI_COST_PER_SEARCH=
