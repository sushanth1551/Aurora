# Copy to .env in the repository root for local development:
#   Copy-Item .env.example .env
# Never commit .env or real credentials. Provider keys are optional for startup
# and tests; research requests need SERPAPI_API_KEY and FIRECRAWL_API_KEY.
# Values below are placeholders only.
APP_NAME=AURORA
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# PostgreSQL (async driver). Matches the docker-compose.yml development default.
DATABASE_URL=postgresql+asyncpg://aurora:aurora_dev_password@localhost:5432/aurora
# Docker Compose only; leave empty to use the compose development default.
POSTGRES_PASSWORD=

# Research providers
SERPAPI_API_KEY=
FIRECRAWL_API_KEY=

# Research engine limits
RESEARCH_MAX_RESULTS=10
RESEARCH_MAX_PAGES=10
RESEARCH_TIMEOUT_SECONDS=60
RESEARCH_MAX_RETRIES=3
RESEARCH_MAX_CONCURRENT_EXTRACTIONS=3
# Optional: HEAD-trace redirects (manually, revalidating every hop) before extraction.
RESEARCH_PREFLIGHT_REDIRECTS=false

# Website intelligence (Module 3) limits. All are caps, not targets.
WEBSITE_RESEARCH_MAX_WEBSITES=10
WEBSITE_RESEARCH_MAX_PAGES_PER_SITE=20
WEBSITE_RESEARCH_MAX_TOTAL_PAGES=100
WEBSITE_RESEARCH_MAX_CRAWL_DEPTH=2
WEBSITE_RESEARCH_MAX_CONCURRENT_SITES=2
WEBSITE_RESEARCH_MAX_CONCURRENT_PAGES=2
WEBSITE_RESEARCH_TIMEOUT_SECONDS=300
WEBSITE_RESEARCH_MAP_TIMEOUT_SECONDS=120
WEBSITE_RESEARCH_BATCH_TIMEOUT_SECONDS=120
WEBSITE_RESEARCH_MAX_CONCURRENT_SEARCHES=2
# Retries for map / batch start: only rate limits (429) are retried; timeouts never are.
WEBSITE_RESEARCH_MAX_RETRIES=1
# In-memory cache of identical searches and maps (0 disables)
WEBSITE_RESEARCH_CACHE_TTL_SECONDS=600
WEBSITE_RESEARCH_CACHE_MAX_ENTRIES=128
# Local caps (not provider plan limits)
FIRECRAWL_SCRAPE_TIMEOUT_SECONDS=30
FIRECRAWL_MAX_CONCURRENT_REQUESTS=2
RESEARCH_RETRY_BASE_DELAY_SECONDS=0.5
RESEARCH_RETRY_MAX_DELAY_SECONDS=8
WEBSITE_RESEARCH_MAX_CONTENT_SIZE_MB=5
WEBSITE_RESEARCH_MAX_MAP_URLS=100
# LLM extraction is optional and off by default; no LLM adapter is implemented yet,
# so enabling it only adds a note to the response and deterministic extraction is used.
WEBSITE_RESEARCH_ENABLE_LLM_EXTRACTION=false
WEBSITE_RESEARCH_ENABLE_REPORTS=true
# Best-effort robots.txt pre-filter (AURORA's own user agent) before scraping.
WEBSITE_RESEARCH_RESPECT_ROBOTS=true

# Tests. Live tests call real providers and spend credits; keep false by default.
AURORA_RUN_LIVE_INTEGRATION_TESTS=false
# Disposable PostgreSQL database for integration tests (never your dev database):
# AURORA_TEST_DATABASE_URL=postgresql+asyncpg://aurora:aurora_dev_password@localhost:5432/aurora_test

# Neo4j (not used yet; only needed with `docker compose --profile graph`)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# LLM providers (future modules)
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# WordPress (future; publishing requires explicit human approval)
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=

# Google Search Console OAuth (future)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Provider protection (local limits, not provider plan limits)
SERPAPI_MAX_CONCURRENT_REQUESTS=2
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
PROVIDER_CIRCUIT_COOLDOWN_SECONDS=30
# Hard cap on provider HTTP requests per intelligence run, retries included (0 = unlimited)
WEBSITE_RESEARCH_MAX_PROVIDER_REQUESTS=0
